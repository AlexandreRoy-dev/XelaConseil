[Unit]
Description=Xela Conseil form mail API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/xela-form
EnvironmentFile=/opt/xela-form/.env
Environment=HOST=127.0.0.1
Environment=PORT=8791
ExecStart=/usr/bin/node /opt/xela-form/form-mail.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
